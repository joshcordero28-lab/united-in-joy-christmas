generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ORGANIZER
  STAFF
}

enum TicketStatus {
  PENDING
  ISSUED
  REVOKED
}

enum CompetitionType {
  INDIVIDUAL
  TEAM
}

enum VoteCategory {
  KING
  QUEEN
}

enum VotingState {
  CLOSED
  OPEN
  REVEALED
}

model EventConfig {
  id                      String      @id @default("default")
  name                    String      @default("United in Love Christmas Party")
  dateLabel               String      @default("[EVENT DATE — TBD]")
  venueLabel              String      @default("[VENUE — TBD]")
  capacity                Int         @default(200)
  registrationOpen        Boolean     @default(true)
  requireApproval         Boolean     @default(false)
  votingEnabledAfterCheckIn Boolean   @default(true)
  allowSelfVote           Boolean     @default(false)
  kingVotingState         VotingState @default(CLOSED)
  queenVotingState        VotingState @default(CLOSED)
  updatedAt               DateTime    @updatedAt
}

model StaffAccount {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         StaffRole
  displayName  String
  createdAt    DateTime  @default(now())
  auditLogs    AuditLog[]
}

model Attendee {
  id                   String       @id @default(cuid())
  fullName             String
  phone                String?
  email                String?
  notes                String?
  ticketToken          String       @unique
  votingCredentialHash String
  /// Plain credential shown once on confirmation; kept hashed for auth. Stored encrypted-at-rest optional future.
  votingCredentialHint String?
  status               TicketStatus @default(ISSUED)
  registeredAt         DateTime     @default(now())
  issuedAt             DateTime?
  revokedAt            DateTime?
  checkedInAt          DateTime?
  checkedInById        String?
  checkInMethod        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  competitionEntries CompetitionEntry[]
  votesCast          Vote[]             @relation("Voter")
  votesReceived      Vote[]             @relation("Nominee")
  checkInEvents      CheckInEvent[]

  @@index([fullName])
  @@index([status])
  @@index([checkedInAt])
}

model Competition {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        CompetitionType
  maxEntries  Int?
  teamSizeMin Int?
  teamSizeMax Int?
  isOpen      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  attendeeId    String
  teamName      String?
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  attendee    Attendee    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([competitionId, attendeeId])
  @@index([competitionId])
}

model Vote {
  id         String       @id @default(cuid())
  category   VoteCategory
  voterId    String
  nomineeId  String
  createdAt  DateTime     @default(now())

  voter   Attendee @relation("Voter", fields: [voterId], references: [id], onDelete: Cascade)
  nominee Attendee @relation("Nominee", fields: [nomineeId], references: [id], onDelete: Cascade)

  @@unique([category, voterId])
  @@index([category, nomineeId])
}

model CheckInEvent {
  id          String   @id @default(cuid())
  attendeeId  String
  action      String
  method      String?
  staffUserId String?
  note        String?
  createdAt   DateTime @default(now())

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  actor StaffAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model RateLimitBucket {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
