generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ORGANIZER
  STAFF
}

enum TicketStatus {
  PENDING
  ISSUED
  REVOKED
}

enum CompetitionType {
  INDIVIDUAL
  TEAM
}

/// Archived King/Queen category enum — kept so LegacyKingQueenVote rows remain readable.
enum VoteCategory {
  KING
  QUEEN
}

enum VotingState {
  CLOSED
  OPEN
  REVEALED
}

/// Whether attendees may see the ballot at all (independent of open/closed).
enum VotingVisibility {
  HIDDEN
  REVEALED
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VoteCastBy {
  SELF
  MANAGER
}

model EventConfig {
  id                        String           @id @default("default")
  name                      String           @default("United in Joy Christmas 2026")
  dateLabel                 String           @default("December 13, 2026")
  venueLabel                String           @default("[VENUE — TBD]")
  capacity                  Int              @default(200)
  registrationOpen          Boolean          @default(true)
  requireApproval           Boolean          @default(false)
  votingEnabledAfterCheckIn Boolean          @default(true)
  /// Deprecated: King/Queen self-vote toggle (legacy UI removed).
  allowSelfVote             Boolean          @default(false)
  /// Deprecated: retained for history; use talentVotingState.
  kingVotingState           VotingState      @default(CLOSED)
  /// Deprecated: retained for history; use talentVotingState.
  queenVotingState          VotingState      @default(CLOSED)
  /// Audience Choice open/closed (OPEN accepts votes; CLOSED does not). Legacy REVEALED mapped to resultsPublished.
  talentVotingState         VotingState      @default(CLOSED)
  /// Default HIDDEN: public must not see voting UI/APIs until organizer reveals.
  talentVotingVisibility    VotingVisibility @default(HIDDEN)
  /// When true, Audience Choice tallies are shown publicly (separate from open/close).
  talentResultsPublished    Boolean          @default(false)
  updatedAt                 DateTime         @updatedAt
}

model StaffAccount {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         StaffRole
  displayName  String
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

/// One registration submission (primary contact / manager) covering one or more attendees.
model RegistrationParty {
  id            String   @id @default(cuid())
  /// Display name of the person who manages this registration.
  managerName   String
  contactPhone  String?
  contactEmail  String?
  notes         String?
  /// Opaque private credential for the management page (never a ticket QR).
  managerToken  String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendees Attendee[]
  votesCast AudienceVote[] @relation("ManagerCastVotes")

  @@index([createdAt])
}

model Attendee {
  id                   String       @id @default(cuid())
  fullName             String
  phone                String?
  email                String?
  notes                String?
  ticketToken          String       @unique
  votingCredentialHash String
  votingCredentialHint String?
  status               TicketStatus @default(ISSUED)
  registeredAt         DateTime     @default(now())
  issuedAt             DateTime?
  revokedAt            DateTime?
  checkedInAt          DateTime?
  checkedInById        String?
  checkInMethod        String?
  /// Party this attendee belongs to (solo registrations are parties of one).
  registrationPartyId  String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  registrationParty  RegistrationParty     @relation(fields: [registrationPartyId], references: [id], onDelete: Restrict)
  competitionEntries CompetitionEntry[]
  /// Archived King/Queen votes cast by this attendee (read-only history).
  legacyVotesCast    LegacyKingQueenVote[] @relation("LegacyVoter")
  /// Archived King/Queen nominations received (read-only history).
  legacyVotesReceived LegacyKingQueenVote[] @relation("LegacyNominee")
  checkInEvents      CheckInEvent[]
  groupsLed          TalentGroup[]         @relation("GroupLeader")
  groupMemberships   TalentGroupMember[]
  /// Vote entitlement consumed for this attendee (at most one).
  audienceVotes      AudienceVote[]

  @@index([fullName])
  @@index([status])
  @@index([checkedInAt])
  @@index([registrationPartyId])
}

model Competition {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        CompetitionType
  maxEntries  Int?
  teamSizeMin Int?
  teamSizeMax Int?
  isOpen      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  attendeeId    String
  teamName      String?
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  attendee    Attendee    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([competitionId, attendeeId])
  @@index([competitionId])
}

/// Archived copy of King/Queen Vote rows. Original "Vote" table data is migrated here; never delete.
model LegacyKingQueenVote {
  id         String       @id
  category   VoteCategory
  voterId    String
  nomineeId  String
  createdAt  DateTime
  archivedAt DateTime     @default(now())

  voter   Attendee @relation("LegacyVoter", fields: [voterId], references: [id], onDelete: Restrict)
  nominee Attendee @relation("LegacyNominee", fields: [nomineeId], references: [id], onDelete: Restrict)

  @@index([category])
  @@index([voterId])
}

model TalentGroup {
  id               String      @id @default(cuid())
  groupName        String
  performanceTitle String
  talentType       String
  leaderAttendeeId String
  status           GroupStatus @default(PENDING)
  performanceOrder Int?
  rejectionNote    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  leader  Attendee            @relation("GroupLeader", fields: [leaderAttendeeId], references: [id], onDelete: Restrict)
  members TalentGroupMember[]
  votes   AudienceVote[]

  @@index([status])
  @@index([performanceOrder])
}

model TalentGroupMember {
  id         String   @id @default(cuid())
  groupId    String
  attendeeId String
  createdAt  DateTime @default(now())

  group    TalentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendee Attendee    @relation(fields: [attendeeId], references: [id], onDelete: Restrict)

  @@unique([groupId, attendeeId])
  /// An attendee may belong to at most one talent group.
  @@unique([attendeeId])
  @@index([groupId])
}

/// One Audience Choice vote per entitlement attendee for one approved group.
model AudienceVote {
  id            String     @id @default(cuid())
  /// The attendee whose check-in entitlement this vote consumes (unique).
  voterId       String     @unique
  groupId       String
  castBy        VoteCastBy @default(SELF)
  /// When castBy=MANAGER, the registration party that submitted the ballot.
  castByPartyId String?
  createdAt     DateTime   @default(now())

  voter       Attendee           @relation(fields: [voterId], references: [id], onDelete: Cascade)
  group       TalentGroup        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  castByParty RegistrationParty? @relation("ManagerCastVotes", fields: [castByPartyId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([castByPartyId])
}

model CheckInEvent {
  id          String   @id @default(cuid())
  attendeeId  String
  action      String
  method      String?
  staffUserId String?
  note        String?
  createdAt   DateTime @default(now())

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  actor StaffAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model RateLimitBucket {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
